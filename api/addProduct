const { GoogleSpreadsheet } = require('google-spreadsheet');
const { JWT } = require('google-auth-library');

export default async function handler(req, res) {
  // --- ДОБАВЛЕНЫ ПРАВИЛЬНЫЕ ЗАГОЛОВКИ CORS ---
  res.setHeader('Access-Control-Allow-Credentials', true);
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'OPTIONS,POST');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');

  // --- ОБРАБОТКА ПРЕФЛАЙТ-ЗАПРОСА ---
  if (req.method === 'OPTIONS') {
    return res.status(200).end();
  }

  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  try {
    const { name, type, balance } = req.body;

    const auth = new JWT({
      email: process.env.GOOGLE_CLIENT_EMAIL,
      key: process.env.GOOGLE_PRIVATE_KEY.replace(/\\n/g, '\n'),
      scopes: ['https://www.googleapis.com/auth/spreadsheets'],
    });

    // --- ИСПРАВЛЕНИЕ ЗДЕСЬ: ЖЁСТКО ПРОПИСАННЫЙ ID ТАБЛИЦЫ ---
    const SPREADSHEET_ID = '5JS4hJ1TWIuDDiggRwx4saNRZmVeEnJa2oiE1rGtkZ8';
    const doc = new GoogleSpreadsheet(SPREADSHEET_ID, auth);
    
    await doc.loadInfo();

    // Берем второй лист (Products)
    const sheet = doc.sheetsByIndex[1]; 
    await sheet.addRow([name, type, balance]);

    return res.status(200).json({ success: true });
  } catch (error) {
    console.error(error);
    return res.status(500).json({ error: error.message });
  }
}